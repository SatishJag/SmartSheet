# Copy to .env.local and fill in values from your Supabase project settings (API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Planning server (npm run dev:server / npm start). Server-side only: never prefix with VITE_.
# SUPABASE_URL / SUPABASE_ANON_KEY default to the VITE_ values above.
# Without ANTHROPIC_API_KEY, drafts are built from history only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Automation (server only; never prefix with VITE_) ---------------------------------------------
# Needed for time based rules (date arrives, recurring), e-mail digests and the public update-request /
# approval links. Take it from Supabase > Project settings > API (the service_role key). Without it the
# app still works: row-change rules and in-app notifications run in the browser. scripts/check-bundle.mjs
# fails the build if this name ever appears in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# E-mail: with both set, Resend sends real mail; without them e-mail is simulated (the message appears in
# the owner's notification centre). PUBLIC_APP_URL is where links in e-mails point (no trailing slash).
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=
# Optional: AUTOMATION_TICK_SECONDS=60, AUTOMATION_EMAIL_PER_DAY=100,
# AUTOMATION_EMAIL_ALLOW_ANONYMOUS=false (real e-mail only for signed-in accounts), TRUST_PROXY=true behind a proxy.
