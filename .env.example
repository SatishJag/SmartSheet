# Copy to .env.local and fill in values from your Supabase project settings (API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Planning server (npm run dev:server / npm start). Server-side only: never prefix with VITE_.
# SUPABASE_URL / SUPABASE_ANON_KEY default to the VITE_ values above.
# Without ANTHROPIC_API_KEY, drafts are built from history only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
