+ * syntax observations they resolve, and literal-channel enumeration at
+ * dynamic sites once the complete trace is known.
+ */
+export const createElectronWrappedIpcSubstitution = ({
+  accumulator,
+  contexts: { step, metadataContext },
+  invocationFacts: {
+    tracedInvocationsOnly,
